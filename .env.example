# Copier ce fichier en ".env" (jamais commité) et renseigner vos vraies valeurs
# Recuperees depuis francetravail.io > Mes applications > metiers-explorer

VITE_FT_CLIENT_ID=PAR_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du token OAuth2 (fixe, ne pas modifier)
VITE_FT_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire

# URL de base de l'API (fixe, ne pas modifier)
VITE_FT_API_BASE_URL=https://api.francetravail.io
